# Claude writes the spoken briefing when this is set. Optional.
#
# Without it the briefing is composed by the deterministic template, which
# lists every section and always works. With it, the same data is read across
# rather than listed — cross-source connections, what to do first, and
# anything not worth saying today left out. Roughly a cent a morning.
#
# Get a key at https://console.anthropic.com.

ANTHROPIC_API_KEY=

# Shared secret for the Zapier calendar push. Optional.
#
# This is the only endpoint in the app that writes, so it is the only one that
# needs a secret. With this unset, /api/calendar/ingest refuses everything and
# the schedule panel shows the sample day — a disabled feature beats an open
# one, even on a tailnet.
#
# In Zapier: Webhooks by Zapier -> POST to
#   http://<machine>.<tailnet>.ts.net:3000/api/calendar/ingest
# with the header `Authorization: Bearer <this token>` and the Google Calendar
# event as the payload.
#
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"

CALENDAR_INGEST_TOKEN=

# Where the pushed calendar is kept. Defaults to .data/calendar.json.
# CALENDAR_STORE=

# Signing key for the sealed session cookie. Optional but recommended.
#
# Without it the app generates a key at boot, which means E*TRADE connections
# don't survive a restart and break outright on any host that runs more than
# one instance. Generate one with:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

SESSION_SECRET=

# E*TRADE — optional. Without these the portfolio panel runs on sample data.
#
# Get a key at https://developer.etrade.com: sign in with your E*TRADE
# account, complete the API Developer Agreement and the User Intent Survey,
# and an individual key is issued on the spot. Sandbox keys come first; a
# production key follows.
#
# Never commit the filled-in file. .env.local is gitignored.

ETRADE_CONSUMER_KEY=
ETRADE_CONSUMER_SECRET=

# "sandbox" (default) or "live"
ETRADE_ENV=sandbox

# Speech — optional, and there are two ways to do it.
#
# With neither set, the briefing is read by the browser's own speech engine:
# free and offline, but a different voice on every platform, and none of the
# good ones on iOS. Either option below gives you one voice everywhere.
#
# 1. Piper — a local binary. No key, no account, no per-word cost, no network.
#    The natural fit for a machine you run yourself and reach over Tailscale.
#
#      https://github.com/rhasspy/piper  (download a voice .onnx alongside it)

PIPER_BIN=
PIPER_VOICE=

# 2. ElevenLabs — better voices, an API key, a per-character cost. Used only
#    when Piper isn't configured. The voice id and model are optional.

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=
