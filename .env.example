# Claude writes the spoken briefing when this is set. Optional.
#
# Without it the briefing is composed by the deterministic template, which
# lists every section and always works. With it, the same data is read across
# rather than listed — cross-source connections, what to do first, and
# anything not worth saying today left out. Roughly a cent a morning.
#
# Get a key at https://console.anthropic.com.

ANTHROPIC_API_KEY=

# Private follow-up chat through a locally running Ollama server. Defaults
# shown here match `ollama run gemma4:e2b`; change either value for another
# Ollama host or model. The browser talks to Miles, never directly to Ollama.

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e2b

# Shared secret for everything Zapier pushes in. Optional.
#
# The ingest routes are the only ones in the app that write, so they are the
# only ones that need a secret. With this unset they all refuse everything and
# the panels show sample data — a disabled feature beats an open one, even on
# a tailnet. One token covers all three; three secrets to rotate would just
# mean two that never get rotated.
#
# In Zapier: Webhooks by Zapier -> POST, with the header
# `Authorization: Bearer <this token>`, to
#
#   .../api/calendar/ingest    Google Calendar
#   .../api/tasks/ingest       Todoist, Google Tasks, Things
#   .../api/email/ingest       Gmail, filtered - see the README
#
# Zapier runs in the cloud and cannot reach a tailnet-only address - expose
# the app to it with `tailscale funnel --bg 3000` first (see the README).
#
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"

CALENDAR_INGEST_TOKEN=

# Where the pushed data is kept. Defaults to .data/{calendar,tasks,mail}.json.
# CALENDAR_STORE=
# TASKS_STORE=
# MAIL_STORE=

# Google - optional, and the no-cost, nothing-exposed way to get your real
# calendar, Gmail and tasks in (the Zapier push above needs a paid Zapier
# plan and a public URL; this needs neither).
#
# One-time setup at https://console.cloud.google.com - the README walks
# through it step by step:
#   1. Create a project, enable the Calendar, Gmail and Tasks APIs.
#   2. OAuth consent screen: External, add yourself as a test user.
#   3. Credentials -> OAuth client ID -> Web application, with redirect URI
#        http://localhost:3000/api/google/callback
#   4. Paste the client id and secret here, restart, click Connect Google.
#
# All three scopes are read-only. The refresh token is sealed under
# SESSION_SECRET and never leaves this machine.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# What the mail panel asks Gmail for. Filter hard - a firehose just rebuilds
# your inbox in a second place.
# GMAIL_SEARCH="is:important is:unread newer_than:2d"

# Signing key for sealed secrets: the E*TRADE session cookie and the stored
# Google refresh token. Optional but strongly recommended - without it the
# app generates a key at boot, so both connections die on every restart.
# Generate one with:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

SESSION_SECRET=

# E*TRADE — optional. Without these the portfolio panel runs on sample data.
#
# Get a key at https://developer.etrade.com: sign in with your E*TRADE
# account, complete the API Developer Agreement and the User Intent Survey,
# and an individual key is issued on the spot. Sandbox keys come first; a
# production key follows.
#
# Never commit the filled-in file. .env.local is gitignored.

ETRADE_CONSUMER_KEY=
ETRADE_CONSUMER_SECRET=

# "sandbox" (default) or "live"
ETRADE_ENV=sandbox

# Optional persistent location for action-managed watchlist symbols.
# Defaults to .data/watchlist.json.
# WATCHLIST_STORE=

# Optional persistent location for Miles' private remembered facts.
# Defaults to .data/memory.json.
# MEMORY_STORE=

# Speech — optional, and there are two ways to do it.
#
# With neither set, the briefing is read by the browser's own speech engine:
# free and offline, but a different voice on every platform, and none of the
# good ones on iOS. Either option below gives you one voice everywhere.
#
# 1. Piper — a local binary. No key, no account, no per-word cost, no network.
#    The natural fit for a machine you run yourself and reach over Tailscale.
#
#      https://github.com/rhasspy/piper  (download a voice .onnx alongside it)

PIPER_BIN=
PIPER_VOICE=

# 2. ElevenLabs — better voices, an API key, a per-character cost. Used only
#    when Piper isn't configured. The voice id and model are optional.

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=

