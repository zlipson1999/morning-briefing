{
  "name": "morning-briefing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev:tailscale": "next dev -H 0.0.0.0",
    "start:tailscale": "next start -H 0.0.0.0",
    "serve:tailscale": "tailscale serve --bg 3000",
    "setup:local-llm": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/setup-local-llm.ps1",
    "setup:local-llm:unix": "bash scripts/setup-local-llm.sh",
    "startup:install": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/install-windows-startup.ps1",
    "startup:remove": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/remove-windows-startup.ps1",
    "startup:status": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/status-miles.ps1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "fast-xml-parser": "^5.11.0",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
